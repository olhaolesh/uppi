# Stage 10A container example.
# Placeholder values only. In Stage 11 / deploy setup, production secrets/config
# should come from AWS Systems Manager Parameter Store, not from committed files.

# Web / auth / session
UPPI_WEB_APP_NAME=UPPI API
UPPI_WEB_APP_VERSION=0.1.0
UPPI_WEB_ENV=local
UPPI_WEB_DEBUG=False
UPPI_WEB_AUTH_USERNAME=operator
UPPI_WEB_AUTH_PASSWORD=change-me
UPPI_WEB_AUTH_PIN=123456
UPPI_WEB_SESSION_SECRET=change-me-session-secret
UPPI_WEB_SESSION_COOKIE_NAME=uppi_session
UPPI_WEB_SESSION_COOKIE_SECURE=False
UPPI_WEB_SESSION_MAX_AGE_SECONDS=43200

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=uppi_db
DB_USER=uppi_user
DB_PASSWORD=change-me-db-password
DB_SSL_MODE=prefer

# Object storage / S3-compatible storage
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
S3_SECURE=False
VISURE_BUCKET=uppi-bucket
ATTESTAZIONI_BUCKET=attestazioni

# AE / SISTER / CAPTCHA runtime
AE_LOGIN_URL=https://example.invalid/login
AE_URL_SERVIZI=https://example.invalid/servizi
SISTER_VISURE_CATASTALI_URL=https://example.invalid/visure-catastali
SISTER_LOGOUT_URL=https://example.invalid/logout
AE_USERNAME=change-me-ae-username
AE_PASSWORD=change-me-ae-password
AE_PIN=change-me-ae-pin
TWO_CAPTCHA_API_KEY=change-me-2captcha-key

# Workspace / logging
UPPI_WORKSPACE_ROOT=/app
UPPI_LOG_DIR=/app/logs
UPPI_LOG_FILE=/app/logs/uppi.log
UPPI_LOG_LEVEL=INFO

# Current runtime overrides that remain env-driven
TEMPLATE_VERSION=pescara2018_v2
PRUNE_OLD_IMMOBILI_WITHOUT_CONTRACTS=True
DELETE_LOCAL_VISURA_AFTER_UPLOAD=False
UPPI_IMMOBILI_YAML=/app/clients/immobili.yml
UPPI_CLIENTS_CSV=/app/clients/clients.csv
UPPI_CLIENTS_YAML=/app/clients/clients.yml
