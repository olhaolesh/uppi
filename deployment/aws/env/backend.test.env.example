# Non-secret backend test values for Stage 11 manual rendering / task definition.
# Secrets belong in AWS Systems Manager Parameter Store and should be injected via
# ECS secrets, not committed in this file.

UPPI_WEB_APP_NAME=UPPI API
UPPI_WEB_APP_VERSION=0.1.0-test
UPPI_WEB_ENV=test
UPPI_WEB_DEBUG=False
UPPI_WEB_SESSION_COOKIE_NAME=uppi_session
UPPI_WEB_SESSION_COOKIE_SECURE=True
UPPI_WEB_SESSION_MAX_AGE_SECONDS=43200

DB_PORT=5432
DB_NAME=uppi_db
DB_SSL_MODE=require

S3_ENDPOINT=s3.<REGION>.amazonaws.com
S3_SECURE=True
VISURE_BUCKET=uppi-test-visure
ATTESTAZIONI_BUCKET=uppi-test-attestazioni

AE_LOGIN_URL=<AE_LOGIN_URL>
AE_URL_SERVIZI=<AE_URL_SERVIZI>
SISTER_VISURE_CATASTALI_URL=<SISTER_VISURE_CATASTALI_URL>
SISTER_LOGOUT_URL=<SISTER_LOGOUT_URL>

UPPI_WORKSPACE_ROOT=/app
UPPI_LOG_DIR=/app/logs
UPPI_LOG_FILE=/app/logs/uppi.log
UPPI_LOG_LEVEL=INFO

UPPI_IMMOBILI_YAML=/app/clients/immobili.yml
UPPI_CLIENTS_CSV=/app/clients/clients.csv
UPPI_CLIENTS_YAML=/app/clients/clients.yml

TEMPLATE_VERSION=pescara2018_v2
PRUNE_OLD_IMMOBILI_WITHOUT_CONTRACTS=True
DELETE_LOCAL_VISURA_AFTER_UPLOAD=False

# SecureString parameters expected at Stage 11:
# - UPPI_WEB_AUTH_USERNAME
# - UPPI_WEB_AUTH_PASSWORD
# - UPPI_WEB_AUTH_PIN
# - UPPI_WEB_SESSION_SECRET
# - DB_HOST
# - DB_USER
# - DB_PASSWORD
# - S3_ACCESS_KEY
# - S3_SECRET_KEY
# - AE_USERNAME
# - AE_PASSWORD
# - AE_PIN
# - TWO_CAPTCHA_API_KEY
