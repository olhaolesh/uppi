{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEcrAuthorizationToken",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEcrRepositoryPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:repository/{{ECR_REPOSITORY_NAME}}"
    },
    {
      "Sid": "AllowCloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:log-group:{{CLOUDWATCH_LOG_GROUP}}:*"
    },
    {
      "Sid": "AllowSsmParametersForEcsSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:parameter/uppi/{{ENVIRONMENT}}/*"
    },
    {
      "Sid": "AllowKmsDecryptForSecureStrings",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "{{SSM_KMS_KEY_ARN}}",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.{{AWS_REGION}}.amazonaws.com"
        }
      }
    }
  ]
}
